{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "MoneyMan",
  "version": "0.1.0",
  "identifier": "com.moneyman.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run tauri:build-web"
  },
  "app": {
    "windows": [
      {
        "title": "MoneyMan",
        "width": 420,
        "height": 800,
        "resizable": true,
        "minWidth": 360,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {
      "openUrl": {
        "enabled": true
      }
    }
  }
}
